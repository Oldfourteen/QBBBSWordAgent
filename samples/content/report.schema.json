{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QBWordAgent 报告内容合同",
  "type": "object",
  "required": [
    "report_title",
    "project_name",
    "code_block_mode",
    "sections"
  ],
  "properties": {
    "report_title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
    },
    "project_name": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40
    },
    "code_block_mode": {
      "type": "string",
      "enum": [
        "none",
        "embedded",
        "after_body"
      ],
      "description": "必须与闸门2确认结果一致：不添加、嵌入正文、置于正文之后"
    },
    "code_blocks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "language": {
            "type": "string",
            "maxLength": 30
          },
          "caption": {
            "type": "string",
            "maxLength": 60
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "section_index": {
            "type": "integer",
            "minimum": 1
          },
          "subsection_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "title",
          "paragraphs"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40,
            "description": "一级标题正文，不含序号；排版器统一添加一、二、三等中文序号"
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "subsections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "paragraphs"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 40
                },
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                },
                "image_placeholder": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          },
          "image_placeholder": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "include_appendix": {
      "type": "boolean",
      "default": false,
      "description": "默认必须省略或设为 false；仅在用户明确要求附录时设为 true"
    },
    "appendices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "front_matter": {
      "type": "object",
      "required": [
        "academic_year",
        "semester",
        "report_title",
        "project_name"
      ],
      "additionalProperties": false,
      "properties": {
        "academic_year": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9
        },
        "semester": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "report_title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60
        },
        "project_name": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "include_appendix": {
            "const": true
          }
        },
        "required": [
          "include_appendix"
        ]
      },
      "then": {
        "required": [
          "appendices"
        ]
      }
    }
  ]
}
